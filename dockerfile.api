FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends build-essential && \
    rm -rf /var/lib/apt/lists/*

# API: usa su propio requirements (incluye Flask/Gunicorn)
COPY requirements-api.txt /requirements.txt
COPY requirements-base.txt /requirements-base.txt
RUN pip install --no-cache-dir -r /requirements.txt

WORKDIR /app
COPY app /app/app
COPY src /app/src
# Los modelos se montan como volumen en docker-compose (read-only)

ENV ARTIFACTS_DIR=/app/models
EXPOSE 8081
CMD ["gunicorn", "-w", "2", "-k", "gthread", "-b", "0.0.0.0:8081", "app.flask_app:app"]
